# ─────────────────────────────────────────────────────────────────────────────
# BillFlow Server — Environment Variables Template
#
# HOW TO USE:
#   Local dev  → copy this to .env.development and fill in local values
#   Production → set these vars directly in Render dashboard (never commit secrets)
#
# The server loads .env.{NODE_ENV} automatically:
#   NODE_ENV=development  →  reads .env.development  (your local machine)
#   NODE_ENV=production   →  Render injects vars from its dashboard
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
#
# Neon gives you TWO connection strings. Use both:
#
# DATABASE_URL = Pooled connection (Connection Pooling ON in Neon dashboard)
#   → Add &pgbouncer=true at the end for Prisma compatibility
#   → Looks like: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true
#
# DIRECT_URL = Direct connection (Connection Pooling OFF in Neon dashboard)
#   → Same URL but hostname has no "-pooler" in it
#   → Looks like: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#   → Used only for Prisma migrations (prisma migrate deploy)
#
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Or let Render auto-generate them (render.yaml has generateValue: true)
JWT_SECRET="generate-a-64-byte-hex-secret"
# (refresh tokens are now opaque, hashed, per-device sessions: no JWT_REFRESH_SECRET needed)

# ── Server ────────────────────────────────────────────────────────────────────
# Render sets PORT automatically — do not set it manually in Render dashboard
PORT=5000
NODE_ENV=development

# Frontend URL — used for CORS allow-list
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app  (set in Render dashboard)
CLIENT_URL="http://localhost:5173"   # comma-separate multiple origins

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Local: use TEST keys from https://dashboard.razorpay.com → API Keys → Test Mode
# Production: use LIVE keys, set in Render dashboard
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# REQUIRED for subscription webhooks (Razorpay dashboard -> Webhooks -> secret). Without it webhooks are rejected.
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# ── Email (password reset) ────────────────────────────────────────────────────
# Any SMTP provider (Brevo, Resend SMTP, SES, Gmail app password...). Unset in dev: links are printed to the console.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user"
# SMTP_PASS="pass"
# MAIL_FROM="BillFlow <no-reply@example.com>"
# RESET_URL_BASE="https://your-app.vercel.app/reset-password"

# ── Cloudinary (logo uploads) ─────────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
